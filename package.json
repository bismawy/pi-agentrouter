{
  "name": "@bismawy/pi-agentrouter",
  "version": "1.6.2",
  "description": "AgentRouter provider for Pi: access frontier models under one namespace with self-healing WAF recovery and automatic turn translation.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "agentrouter",
    "provider",
    "model-provider",
    "waf-recovery",
    "llm-router"
  ],
  "author": "bismawy",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "agentrouter-commands.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/bismawy/pi-agentrouter/main/assets/banner.webp"
  },
  "imports": {
    "#extension": "./index.ts"
  },
  "scripts": {
    "dev": "pi -e ./index.ts",
    "test": "node ./check-framing.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismawy/pi-agentrouter.git"
  }
}
